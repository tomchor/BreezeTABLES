#!/bin/bash -l
# Animate a TABLES run with animate.jl, on a Casper CPU node. Submitted by submit_case.sh.
#
# Variables passed with `qsub -v`:
#   RUN_DIR          directory of the run: holds settings.env and the output, and gets the animation
#   ANIMATION_CODE   directory of animate.jl and of its Julia environment: the repository, or the copy
#                    of the code in a run directory
#PBS -A UMCP0061
#PBS -q casper
#PBS -l job_priority=regular
#PBS -l select=1:ncpus=4:mem=32GB
#PBS -l walltime=01:00:00
#PBS -r n
#PBS -j oe

set -eo pipefail

# RUN and CASE
set -a
source "$RUN_DIR/settings.env"
set +a

module --force purge
module load ncarenv/23.10

export JULIA_DEPOT_PATH=/glade/work/$USER/.julia
export JULIA_CPU_TARGET=generic

echo "job $PBS_JOBID, animation of $RUN on $(hostname), $(date)"
echo "animate.jl of $ANIMATION_CODE"

time julia +1.13 --startup-file=no --project="$ANIMATION_CODE" --threads="${NCPUS:-4}" --pkgimages=no \
     "$ANIMATION_CODE/animate.jl" "$RUN_DIR" "$CASE" 2>&1 | tee "$RUN_DIR/logs/animation.out"

echo "finished $(date)"
